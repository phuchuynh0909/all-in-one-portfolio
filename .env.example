APP_PROJECT_NAME=Investment Tracker API
APP_API_V1_PREFIX=/api/v1
APP_ENVIRONMENT=development

# DNSE OpenAPI — real-time matched prices (chart realtime bar updates)
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_API_VERSION=2026-05-07

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=all-in-one-portfolio

# Auth — HS256 signing key for app login tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production; without it the backend refuses to start.
APP_AUTH_SECRET_KEY=
APP_AUTH_TOKEN_TTL_DAYS=30
