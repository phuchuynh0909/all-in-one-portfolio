# ISP (Intraday Seasonality Profile) Configuration
# Copy this file to .env in the worker directory and adjust values as needed

# ============================================
# ISP Parameters
# ============================================

# Bin size in minutes for volume aggregation
ISP_BIN_MINUTES=15

# Comma-separated list of window sizes (in minutes) for multi-timeframe analysis
# Note: ISP_BIN_MINUTES and 60 will be automatically included if not present
# Default includes 5, 15, 30, and 60 minute windows for comprehensive analysis
# IMPORTANT: These windows must match the schema in model.py (abnormality_ratio_5m, 15m, 30m, 60m)
ISP_WINDOWS=5,15,30,60

# Exponential smoothing factor for ISP curve updates (0.0 to 1.0)
# Higher values = more weight on recent data
ISP_ALPHA=0.05

# Trading session hours in exchange local time (format: "HH:MM,HH:MM")
# Start time, End time
ISP_SESSION=09:00,14:45

# Exchange timezone for session calculations
EXCHANGE_TZ=Asia/Ho_Chi_Minh

# Number of historical days to use for bootstrapping ISP curves
ISP_BOOTSTRAP_DAYS=3

# ============================================
# ClickHouse Database Configuration
# ============================================

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9010
CLICKHOUSE_USER=myuser
CLICKHOUSE_PASSWORD=mypassword
CLICKHOUSE_DB=default

# ============================================
# MQTT Broker Configuration (for live data)
# ============================================

# MQTT broker hostname
MQTT_HOST=datafeed-lts-krx.dnse.com.vn

# MQTT broker port
MQTT_PORT=443

# Comma-separated list of MQTT topics to subscribe to
# If empty, topics will be automatically loaded from MQTT_WATCHLIST_FILE
# MQTT_TOPICS=plaintext/quotes/krx/mdds/tick/v1/roundlot/symbol/VCG,plaintext/quotes/krx/mdds/tick/v1/roundlot/symbol/YEG
MQTT_TOPICS=

# Path to watchlist JSON file (relative to worker directory or absolute path)
# Used to auto-generate MQTT topics when MQTT_TOPICS is empty
MQTT_WATCHLIST_FILE=watchlist.json

# Template for generating MQTT topics from symbols
# Use {symbol} as placeholder for the stock symbol
MQTT_TOPIC_TEMPLATE=plaintext/quotes/krx/mdds/tick/v1/roundlot/symbol/{symbol}

# ============================================
# Mock Data Source Configuration (for testing)
# ============================================

# Enable mock data source instead of live MQTT feed (1=enabled, 0=disabled)
ISP_USE_MOCK=0

# Comma-separated list of symbols to replay from ClickHouse
ISP_MOCK_SYMBOLS=ANV

# Start timestamp for mock data replay (format: YYYY-MM-DD HH:MM:SS)
ISP_MOCK_START=2025-10-17 09:00:00

# End timestamp for mock data replay (format: YYYY-MM-DD HH:MM:SS)
ISP_MOCK_END=2025-10-17 14:45:00

# Replay speed multiplier (1.0 = real-time, 2.0 = 2x speed, etc.)
ISP_MOCK_SPEED=1.0

# Loop replay continuously (1=enabled, 0=disabled)
ISP_MOCK_LOOP=0

